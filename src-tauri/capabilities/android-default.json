{
  "$schema": "../gen/schemas/mobile-schema.json",
  "identifier": "android-default",
  "description": "Android MarkFlow capabilities",
  "platforms": ["android"],
  "windows": ["main"],
  "permissions": [
    "core:default",
    "fs:default",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-write-file",
    "fs:allow-exists",
    "fs:allow-mkdir",
    "fs:allow-read-dir",
    "fs:allow-remove",
    "fs:scope-app-recursive"
  ]
}
